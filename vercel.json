{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@5.1.0",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "comment": "The service worker decides how long everything else is cached, so it must never be cached itself — a stale sw.js pins the whole app to an old release.",
      "source": "/sw.js",
      "headers": [
        { "key": "cache-control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "service-worker-allowed", "value": "/" }
      ]
    },
    {
      "comment": "Same reasoning for the shell: sw.js is network-first, and index.html is what bootstraps it.",
      "source": "/index.html",
      "headers": [{ "key": "cache-control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" },
        { "key": "x-frame-options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
